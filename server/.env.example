# Connection String จาก Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/taskflow?sslmode=require"

# ค่าลับสำหรับเซ็น JWT — เปลี่ยนเป็นค่าของคุณเอง (ยาว ๆ สุ่ม ๆ)
JWT_SECRET="change-me-to-a-long-random-secret"

# พอร์ตของ API server
PORT=3000

# Origin ของ frontend ที่อนุญาตให้เรียก API (CORS)
CORS_ORIGIN="http://localhost:5173"
